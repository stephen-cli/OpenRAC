#
# Writes OUTPUT, a C++ header with each assembled RSX program of INPUTS (a ;-list of files) as an
# array of bytes in namespace openrac::rsxgl::programs, named after the file (direct.vpo ->
# direct_vpo). Run by cmake/Window.cmake at build time:
#   cmake -DINPUTS=a.vpo;a.fpo -DOUTPUT=rsx_programs.h -P embed.cmake
set(text "// Generated by port/renderer/rsx/programs/embed.cmake; do not edit.\n#pragma once\n\nnamespace openrac::rsxgl::programs {\n")
foreach(input IN LISTS INPUTS)
  get_filename_component(name "${input}" NAME)
  string(REPLACE "." "_" symbol "${name}")
  file(READ "${input}" bytes HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${bytes}")
  string(APPEND text "alignas(16) inline constexpr unsigned char ${symbol}[] = {${bytes}};\n")
endforeach()
string(APPEND text "}  // namespace openrac::rsxgl::programs\n")
file(WRITE "${OUTPUT}" "${text}")
