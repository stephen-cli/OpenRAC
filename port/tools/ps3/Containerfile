# The PS3 toolchain for the port (README.md): ps3dev's layout with ps3toolchain's prebuilt nightly (GCC
# 13.2 for the Cell's PPU and SPU) and PSL1GHT and ps3libraries built from source, at pinned commits, on Ubuntu
# 24.04 (the prebuilt toolchain needs its glibc); then the libraries built for the port over it (toolchain.sh:
# newlib 4.6 with the console's pieces, GCC again with posix threads over pthreads-embedded, the system call
# glue, PSL1GHT again). Build with podman or docker, in two to three hours:
#
#   podman build -t openrac-ps3 port/tools/ps3
#
# and configure the port in it with port/tools/ps3/ppu.cmake as the toolchain file.
FROM --platform=linux/amd64 docker.io/library/ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends autoconf automake bison bzip2 \
        ca-certificates cmake curl flex g++ gcc git libelf-dev libgmp3-dev libncurses-dev libssl-dev \
        libtool libtool-bin make ninja-build patch pkg-config python-is-python3 python3 python3-dev \
        subversion tar texinfo wget xz-utils zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# ps3dev main of 2026-10-28; PSL1GHT and ps3libraries of 2026-11-04; the toolchain nightly built from
# ps3toolchain's GCC 13.2 scripts (2026-10-11).
ARG PS3DEV_COMMIT=ae86d7c283bebca0a0aaab670183ef869307f8ba
ARG PSL1GHT_COMMIT=dd4e8c9be744e3273d665c393fa6d97a87402e2e
ARG PS3LIBRARIES_COMMIT=f671e1158e5db2520c172bd600d55d9fce3d15d0
ARG TOOLCHAIN_RELEASE=nightly-2026-10-11

ENV PS3DEV=/usr/local/ps3dev
ENV PSL1GHT=/usr/local/ps3dev
ENV PATH=$PATH:/usr/local/ps3dev/bin:/usr/local/ps3dev/ppu/bin:/usr/local/ps3dev/spu/bin

RUN git clone https://github.com/ps3dev/ps3dev.git /opt/ps3dev \
    && git -C /opt/ps3dev checkout --quiet $PS3DEV_COMMIT \
    && cd /opt/ps3dev \
    && PINNED_TOOLCHAIN_RELEASE=$TOOLCHAIN_RELEASE PSL1GHT_REF=$PSL1GHT_COMMIT \
       PS3LIBRARIES_REF=$PS3LIBRARIES_COMMIT ./build-all.sh \
    && rm -rf /opt/ps3dev/build

# The libraries for the port (README.md, "Route 1"); the sources and build trees are removed after.
COPY toolchain.sh newlib-lv2.py gcc-13.2.0-savres.patch /opt/openrac-ps3/
COPY newlib-lv2 /opt/openrac-ps3/newlib-lv2
RUN PSL1GHT_REF=$PSL1GHT_COMMIT PS3LIBRARIES_REF=$PS3LIBRARIES_COMMIT bash /opt/openrac-ps3/toolchain.sh \
    && rm -rf /opt/openrac-toolchain /opt/ps3dev/build

WORKDIR /src
