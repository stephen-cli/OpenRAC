# The big-endian boot test's toolchain (README.md): the port built headless for x86-64 (the baseline, and the
# extractor, with Clang) and for 64-bit big-endian PowerPC Linux (Debian's cross GCC, ppc64be.cmake), the PowerPC
# binaries run under qemu-user.
#   podman build --platform linux/amd64 -t openrac-be port/tools/bigendian
FROM --platform=linux/amd64 docker.io/library/debian:trixie
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates cmake ninja-build git python3 clang lld llvm \
        g++ g++-powerpc64-linux-gnu qemu-user file \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
